rules_version = '2';

// prayer-requests-9d290 프로젝트 하나를 세 앱이 나눠 쓰는 구조입니다.
//   boards/     → 훈련관앱 (기도제목보드를 확장한 것. 캘린더·청소·리딩표·기도제목·편지)
//   bible_sync/ → 암송카드앱 (성경공부 답변·묵상 동기화)
//
// 공통 원칙: 익명 로그인을 통과한 요청만 허용하고, 목록 훑기(list)는 막습니다.
//
// 2026-10-12 바뀐 점: boards/{boardId} 아래 하위 컬렉션을 members·archives 두 개만
// 열어 두던 것을 전부(calendar·cleaning·reading·letters 포함)로 넓혔습니다.
// 기존 기도제목보드도 이 규칙으로 그대로 돌아갑니다.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────── 훈련관앱 / 기도제목보드 ───────────
    // 접근 방식: "링크를 아는 사람만"
    //  - boardId 는 24자리 무작위 문자열이라 추측이 사실상 불가능합니다.
    //  - list 를 막아두었기 때문에 보드 목록을 훑어서 찾아낼 수 없습니다.
    //
    // 주의: 링크를 아는 사람은 누구나 읽고 고칠 수 있습니다.
    //       링크를 단톡방 밖으로 내보내지 마세요.
    match /boards/{boardId} {
      // 보드 목록 통째로 훑기 차단 (이게 핵심)
      allow list: if false;

      allow get, create, update:
        if request.auth != null && boardId.size() >= 20;

      // 보드 통째 삭제는 막음 (실수 방지)
      allow delete: if false;

      // 보드 아래 모든 하위 컬렉션 (members, archives, calendar, reading, letters …)
      match /{document=**} {
        allow read, write:
          if request.auth != null && boardId.size() >= 20;
      }
    }

    // ─────────── 암송카드앱 ───────────
    // 접근 방식: "동기화 코드를 아는 기기만"
    //  - 코드는 본인이 정하고, 6자 이상만 허용합니다.
    //  - 코드 목록 훑기를 막아두어 남의 코드를 찾아낼 수 없습니다.
    //
    // 주의: 코드를 아는 사람은 누구나 읽고 고칠 수 있습니다.
    //       이름처럼 뻔한 코드 대신 숫자를 섞어 쓰세요.
    match /bible_sync/{syncCode} {
      // 코드 목록 통째로 훑기 차단
      allow list: if false;

      // answers/, memos/ 등 코드 아래 전부
      match /{document=**} {
        allow read, write:
          if request.auth != null && syncCode.size() >= 6;
      }
    }

    // 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
